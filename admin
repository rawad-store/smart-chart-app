import React, { useState, useRef } from 'react';
import { Upload, Zap, TrendingUp, TrendingDown, AlertCircle, CheckCircle, Loader } from 'lucide-react';

const SmartChartAnalyzer = () => {
    const [selectedFile, setSelectedFile] = useState(null);
    const [preview, setPreview] = useState(null);
    const [analysis, setAnalysis] = useState(null);
    const [loading, setLoading] = useState(false);
    const [assetName, setAssetName] = useState('');
    const [currentPrice, setCurrentPrice] = useState('');
    const fileInputRef = useRef(null);

    const MAX_FILE_SIZE = 5 * 1024 * 1024; // 5 ميجابايت

    const handleFileSelect = (e) => {
        const file = e.target.files[0];
        if (!file) return;

        if (!file.type.startsWith('image/')) {
            alert('يرجى اختيار ملف صورة فقط');
            return;
        }

        if (file.size > MAX_FILE_SIZE) {
            alert('حجم الصورة كبير جداً (الحد الأقصى 5 ميجابايت)');
            return;
        }

        setSelectedFile(file);
        const reader = new FileReader();
        reader.onload = (ev) => setPreview(ev.target.result);
        reader.readAsDataURL(file);
    };

    const analyzeChart = async () => {
        if (!preview || !assetName || !currentPrice) {
            alert('يرجى ملء جميع الحقول');
            return;
        }

        setLoading(true);

        try {
            // محاكاة تحليل الصورة - في الواقع ستحتاج API حقيقي
            const mockAnalysis = performChartAnalysis();
            await new Promise((r) => setTimeout(r, 1800));
            setAnalysis(mockAnalysis);
        } catch (error) {
            console.error(error);
            alert('حدث خطأ أثناء التحليل');
        } finally {
            setLoading(false);
        }
    };

    const performChartAnalysis = () => {
        // محاكاة ذكية - يمكن استبدالها لاحقاً بـ Claude / Gemini / Grok Vision API
        const technicalScore = Math.floor(Math.random() * 7) - 3;
        const fundamentalScore = Math.floor(Math.random() * 5) - 2;
        const riskScore = Math.floor(Math.random() * 5) - 2;

        const totalScore = technicalScore + fundamentalScore + riskScore;

        let decision = 'محايد';
        let confidence = 55;
        let color = 'yellow';
        let trend = 'محايد';

        if (totalScore >= 5) {
            decision = 'شراء قوي';
            confidence = 88;
            color = 'green';
            trend = 'صاعد جداً';
        } else if (totalScore >= 2) {
            decision = 'شراء';
            confidence = 72;
            color = 'green';
            trend = 'صاعد';
        } else if (totalScore <= -5) {
            decision = 'بيع قوي';
            confidence = 88;
            color = 'red';
            trend = 'هابط جداً';
        } else if (totalScore <= -2) {
            decision = 'بيع';
            confidence = 72;
            color = 'red';
            trend = 'هابط';
        }

        const price = parseFloat(currentPrice) || 100;

        return {
            decision,
            confidence,
            color,
            trend,
            technicalScore,
            fundamentalScore,
            riskScore,
            totalScore,
            chartPatterns: ['كسر مقاومة', 'مثلث صاعد', 'رأس وكتفين معكوس', 'علم صاعد'].sort(() => Math.random() - 0.5).slice(0, 2 + Math.floor(Math.random() * 2)),
            supportLevels: [(price * 0.96).toFixed(2), (price * 0.92).toFixed(2), (price * 0.87).toFixed(2)],
            resistanceLevels: [(price * 1.04).toFixed(2), (price * 1.09).toFixed(2), (price * 1.15).toFixed(2)],
            rsiValue: Math.floor(30 + Math.random() * 70),
            macdTrend: ['صاعد', 'هابط', 'محايد'][Math.floor(Math.random() * 3)],
            volumeTrend: ['مرتفع', 'متوسط', 'منخفض'][Math.floor(Math.random() * 3)],
            recommendedEntryPrice: (price * (0.975 + Math.random() * 0.05)).toFixed(2),
            recommendedTakeProfit: (price * (1.07 + Math.random() * 0.18)).toFixed(2),
            recommendedStopLoss: (price * (0.915 + Math.random() * 0.04)).toFixed(2),
        };
    };

    const resetForm = () => {
        setSelectedFile(null);
        setPreview(null);
        setAnalysis(null);
        setAssetName('');
        setCurrentPrice('');
        if (fileInputRef.current) fileInputRef.current.value = '';
    };

    const colorClass = {
        green: 'text-emerald-500',
        red: 'text-rose-500',
        yellow: 'text-amber-500',
    };

    const bgColorClass = {
        green: 'from-emerald-950 to-emerald-900 border-emerald-700/50',
        red: 'from-rose-950 to-rose-900 border-rose-700/50',
        yellow: 'from-amber-950 to-amber-900 border-amber-700/50',
    };

    return (
        <div className="min-h-screen bg-gradient-to-br from-slate-950 via-indigo-950 to-slate-950 p-5 md:p-8 text-right">
            <style>{`
                @import url('https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap');

                * { font-family: 'Outfit', system-ui, sans-serif; }

                .glass {
                    background: rgba(15, 23, 42, 0.65);
                    backdrop-filter: blur(16px);
                    -webkit-backdrop-filter: blur(16px);
                    border: 1px solid rgba(100, 200, 255, 0.18);
                    border-radius: 16px;
                    transition: all 0.35s ease;
                }

                .glass:hover {
                    border-color: rgba(100, 200, 255, 0.35);
                    background: rgba(15, 23, 42, 0.8);
                    transform: translateY(-3px);
                }

                .upload-area {
                    border: 2px dashed rgba(100, 200, 255, 0.35);
                    border-radius: 16px;
                    padding: 3rem 1.5rem;
                    text-align: center;
                    cursor: pointer;
                    transition: all 0.3s ease;
                    background: rgba(2, 13, 46, 0.3);
                }

                .upload-area:hover {
                    border-color: rgba(100, 200, 255, 0.6);
                    background: rgba(2, 13, 46, 0.45);
                }

                .input-field {
                    background: rgba(3, 7, 30, 0.7);
                    border: 1px solid rgba(100, 200, 255, 0.22);
                    border-radius: 10px;
                    padding: 0.9rem 1.1rem;
                    color: white;
                    transition: all 0.25s;
                }

                .input-field:focus {
                    outline: none;
                    border-color: rgba(100, 200, 255, 0.7);
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
                }

                .btn-primary {
                    background: linear-gradient(135deg, #3b82f6, #1d4ed8);
                    padding: 0.9rem 2rem;
                    border-radius: 10px;
                    font-weight: 700;
                    box-shadow: 0 6px 20px rgba(59, 130, 246, 0.35);
                    transition: all 0.3s;
                }

                .btn-primary:hover:not(:disabled) {
                    transform: translateY(-2px);
                    box-shadow: 0 10px 28px rgba(59, 130, 246, 0.5);
                }

                .btn-reset {
                    background: rgba(100, 200, 255, 0.12);
                    color: #7dd3fc;
                    border: 1px solid rgba(100, 200, 255, 0.35);
                    padding: 0.8rem 1.8rem;
                    border-radius: 10px;
                    font-weight: 600;
                    transition: all 0.3s;
                }

                .btn-reset:hover {
                    background: rgba(100, 200, 255, 0.22);
                    border-color: rgba(100, 200, 255, 0.6);
                }

                .decision-box {
                    background: linear-gradient(135deg, rgba(15,23,42,0.92), rgba(30,41,59,0.75));
                    border: 2px solid rgba(100,200,255,0.25);
                    border-radius: 20px;
                    padding: 2.5rem;
                    animation: fadeUp 0.7s ease-out;
                }

                @keyframes fadeUp {
                    from { opacity: 0; transform: translateY(35px); }
                    to   { opacity: 1; transform: translateY(0); }
                }

                .progress-ring {
                    transform: rotate(-90deg);
                }

                .progress-ring__circle {
                    transition: stroke-dashoffset 0.6s ease;
                }
            `}</style>

            <div className="max-w-5xl mx-auto">
                {/* Header */}
                <div className="text-center mb-10">
                    <div className="flex items-center justify-center gap-3 mb-4">
                        <Zap size={44} className="text-blue-400" />
                        <h1 className="text-4xl md:text-5xl font-extrabold bg-gradient-to-r from-cyan-300 via-blue-300 to-indigo-400 bg-clip-text text-transparent">
                            محلل الشارت الذكي
                        </h1>
                    </div>
                    <p className="text-slate-400 text-lg">
                        ارفع صورة الشارت واحصل على تحليل سريع + توصية واضحة
                    </p>
                </div>

                {!analysis ? (
                    <div className="space-y-8">
                        <div className="glass p-7 md:p-10">
                            <h2 className="text-2xl font-bold text-white mb-7">البيانات الأساسية</h2>

                            <div className="grid grid-cols-1 md:grid-cols-2 gap-6 mb-9">
                                <div>
                                    <label className="block text-slate-300 text-sm font-semibold mb-3">اسم الأصل / الرمز</label>
                                    <input
                                        type="text"
                                        value={assetName}
                                        onChange={(e) => setAssetName(e.target.value)}
                                        placeholder="مثال: BTCUSDT • AAPL • 7203.SR"
                                        className="input-field w-full"
                                    />
                                </div>
                                <div>
                                    <label className="block text-slate-300 text-sm font-semibold mb-3">السعر الحالي</label>
                                    <input
                                        type="number"
                                        min="0.0000001"
                                        step="any"
                                        value={currentPrice}
                                        onChange={(e) => {
                                            const v = e.target.value;
                                            if (v === '' || Number(v) >= 0) setCurrentPrice(v);
                                        }}
                                        placeholder="0.00"
                                        className="input-field w-full"
                                    />
                                </div>
                            </div>

                            <div className="mb-7">
                                <label className="block text-slate-300 text-sm font-semibold mb-3">صورة الشارت</label>
                                <div className="upload-area" onClick={() => fileInputRef.current?.click()}>
                                    <input
                                        ref={fileInputRef}
                                        type="file"
                                        accept="image/*"
                                        onChange={handleFileSelect}
                                        hidden
                                    />
                                    <div className="flex flex-col items-center gap-4 text-slate-300">
                                        <Upload size={48} className="text-blue-400" />
                                        <div className="text-center">
                                            <p className="font-bold text-white">اضغط هنا أو اسحب الصورة</p>
                                            <p className="text-sm mt-1">PNG • JPG • WEBP • max 5MB</p>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {preview && (
                                <div className="mb-8">
                                    <p className="text-slate-300 text-sm font-semibold mb-3">معاينة الصورة</p>
                                    <img
                                        src={preview}
                                        alt="معاينة الشارت"
                                        className="max-h-80 mx-auto rounded-xl border border-slate-700/50 shadow-xl object-contain"
                                    />
                                </div>
                            )}

                            <div className="flex flex-col sm:flex-row gap-4">
                                <button
                                    onClick={analyzeChart}
                                    disabled={loading || !preview || !assetName || !currentPrice}
                                    className="btn-primary text-white font-bold flex-1 flex items-center justify-center gap-2 disabled:opacity-50 disabled:cursor-not-allowed"
                                >
                                    {loading ? (
                                        <>
                                            <Loader className="animate-spin" size={20} />
                                            جاري التحليل...
                                        </>
                                    ) : (
                                        <>
                                            <Zap size={20} />
                                            حلل الشارت الآن
                                        </>
                                    )}
                                </button>

                                <button onClick={resetForm} className="btn-reset">
                                    إعادة تعيين
                                </button>
                            </div>
                        </div>

                        {/* تعليمات سريعة */}
                        <div className="glass p-6 text-slate-300 text-sm">
                            <h3 className="text-lg font-bold text-white mb-4">كيف تستخدم الأداة؟</h3>
                            <ol className="space-y-3 list-decimal list-inside">
                                <li>أدخل اسم الأصل والسعر الحالي</li>
                                <li>ارفع صورة شارت واضحة (يفضل يومي أو 4 ساعات)</li>
                                <li>اضغط "حلل الشارت الآن"</li>
                                <li>اقرأ التوصية والمستويات بعناية</li>
                            </ol>
                            <p className="mt-4 text-amber-400 text-xs">
                                ملاحظة: التحليل حالياً محاكاة – سيتم ربطه بنموذج رؤية قريباً
                            </p>
                        </div>
                    </div>
                ) : (
                    <div className="space-y-8">
                        {preview && (
                            <div className="glass p-6">
                                <h3 className="text-lg font-bold text-white mb-4">الشارت المحلل</h3>
                                <img
                                    src={preview}
                                    alt="الشارت الأصلي"
                                    className="max-h-[420px] mx-auto rounded-xl border border-blue-600/30 shadow-2xl object-contain"
                                />
                            </div>
                        )}

                        <div className={`decision-box ${bgColorClass[analysis.color]}`}>
                            <div className="flex flex-col md:flex-row justify-between items-start md:items-center gap-8 mb-10">
                                <div className="flex-1">
                                    <p className="text-slate-400 uppercase text-xs font-semibold tracking-wider mb-2">القرار الرئيسي</p>
                                    <div className="flex items-center gap-5">
                                        {analysis.color === 'green' ? (
                                            <TrendingUp size={64} className={colorClass[analysis.color]} />
                                        ) : analysis.color === 'red' ? (
                                            <TrendingDown size={64} className={colorClass[analysis.color]} />
                                        ) : (
                                            <AlertCircle size={64} className={colorClass[analysis.color]} />
                                        )}
                                        <div>
                                            <h2 className={`text-4xl md:text-5xl font-black ${colorClass[analysis.color]}`}>
                                                {analysis.decision}
                                            </h2>
                                            <p className="text-slate-300 mt-1">
                                                الاتجاه: <strong className="text-blue-300">{analysis.trend}</strong>
                                            </p>
                                        </div>
                                    </div>
                                </div>

                                <div className="text-center">
                                    <p className="text-slate-400 uppercase text-xs font-semibold tracking-wider mb-3">مستوى الثقة</p>
                                    <div className="relative w-28 h-28 mx-auto">
                                        <svg className="absolute inset-0 w-full h-full progress-ring" viewBox="0 0 120 120">
                                            <circle
                                                className="progress-ring__circle"
                                                cx="60"
                                                cy="60"
                                                r="52"
                                                fill="none"
                                                stroke="#334155"
                                                strokeWidth="12"
                                            />
                                            <circle
                                                className="progress-ring__circle"
                                                cx="60"
                                                cy="60"
                                                r="52"
                                                fill="none"
                                                stroke={analysis.color === 'green' ? '#10b981' : analysis.color === 'red' ? '#ef4444' : '#f59e0b'}
                                                strokeWidth="12"
                                                strokeDasharray="327"
                                                strokeDashoffset={327 - (327 * analysis.confidence) / 100}
                                                strokeLinecap="round"
                                            />
                                        </svg>
                                        <div className="absolute inset-0 flex flex-col items-center justify-center">
                                            <span className={`text-4xl font-black ${colorClass[analysis.color]}`}>
                                                {analysis.confidence}%
                                            </span>
                                            <span className="text-xs text-slate-400 mt-1">ثقة</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {/* باقي النتائج بنفس الطريقة السابقة */}
                            {/* ... (يمكنك لصق باقي JSX من النسخة السابقة هنا إذا أردت الاحتفاظ بكل التفاصيل) ... */}

                            <div className="mt-10">
                                <button
                                    onClick={resetForm}
                                    className="w-full btn-reset text-lg py-4"
                                >
                                    ✦ تحليل شارت جديد
                                </button>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

export default SmartChartAnalyzer;
